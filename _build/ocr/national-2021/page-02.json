      "y": 0.49273255813311345
    },
    {
      "confidence": 1,
      "height": 0.014675878424107114,
      "text": "있어 PSK(Phase Shift Keying)보다 수신기 구현이 간단하다.",
      "width": 0.4004106829243322,
