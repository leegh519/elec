      "y": 0.15988372113976834
    },
    {
      "confidence": 1,
      "height": 0.016090682109058285,
      "text": "3. 고대역폭 메모리(High Bandwidth Memory, HBM)에",
      "width": 0.40946500423123455,
      "x": 0.5061728504563991,
      "y": 0.15988372136105744
    },
    {
      "confidence": 1,
      "height": 0.014648186182684486,
